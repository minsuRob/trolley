#!/bin/sh
# Hands the install directory to the person who ran the installer.
#
# `trolley update` swaps the binary with rename(2), which needs write access to
# the *directory*, not to the file. Owning it here is what lets updates run
# without an admin prompt -- and it is why trolley lives in its own directory
# instead of /usr/local/bin, which is root-owned and shared with everything else.
set -e

PREFIX=/usr/local/trolley

OWNER=$(stat -f%Su /dev/console 2>/dev/null || true)
if [ -z "$OWNER" ] || [ "$OWNER" = "root" ]; then
    OWNER="${SUDO_USER:-}"
fi

if [ -n "$OWNER" ] && [ "$OWNER" != "root" ]; then
    chown -R "$OWNER" "$PREFIX"
else
    echo "warning: 로그인 사용자를 찾지 못해 $PREFIX 소유권을 그대로 둡니다." >&2
    echo "warning: 업데이트 시 관리자 권한이 필요할 수 있습니다." >&2
fi

chmod 755 "$PREFIX/bin/trolley"
exit 0
